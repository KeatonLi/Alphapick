# 服务器配置
ALPHAPICK_PORT=8084

# 数据库配置（兼容旧变量名 QUANTFORGE_DB_*）
ALPHAPICK_DB_HOST=localhost
ALPHAPICK_DB_PORT=3306
ALPHAPICK_DB_USER=root
ALPHAPICK_DB_PASSWORD=your_password_here
ALPHAPICK_DB_NAME=alphapick

# AI API 配置（OpenAI 兼容协议，如 DeepSeek / MiniMax / OpenAI）
# 兼容旧变量名：ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL / ANTHROPIC_MODEL
LLM_AUTH_TOKEN=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=DeepSeek-V4-Flash
