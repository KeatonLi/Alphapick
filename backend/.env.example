# 服务器配置
QUANTFORGE_PORT=8084

# 数据库配置
QUANTFORGE_DB_HOST=localhost
QUANTFORGE_DB_PORT=3306
QUANTFORGE_DB_USER=root
QUANTFORGE_DB_PASSWORD=your_password_here
QUANTFORGE_DB_NAME=quantforge

# AI API 配置 (Anthropic 兼容)
ANTHROPIC_AUTH_TOKEN=your_api_key_here
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=MiniMax-M2.7-highspeed
