# 服务器配置
QUANTFORGE_PORT=8084

# 数据库配置
QUANTFORGE_DB_HOST=localhost
QUANTFORGE_DB_PORT=3306
QUANTFORGE_DB_USER=root
QUANTFORGE_DB_PASSWORD=your_password_here
QUANTFORGE_DB_NAME=quantforge

# AI API 配置（OpenAI 兼容协议，如 DeepSeek / MiniMax / OpenAI）
# 兼容旧变量名：ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL / ANTHROPIC_MODEL
LLM_AUTH_TOKEN=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=DeepSeek-V4-Flash
